SUNO_COOKIE=
# Multi-account (optional). SUNO_COOKIE becomes the account with id SUNO_DEFAULT_ACCOUNT_ID.
SUNO_DEFAULT_ACCOUNT_ID=default
# Extra read-only accounts as JSON: [{"id":"main","label":"Main","cookie":"__client=..."}]
SUNO_ACCOUNTS=
# Where accounts added through POST /api/accounts are stored (contains cookies!). Default: ./.data/accounts.json
SUNO_ACCOUNTS_FILE=
# If set, POST/PATCH/DELETE /api/accounts require the header x-admin-token: <value>
SUNO_ACCOUNTS_ADMIN_TOKEN=
# Suno studio API base URL (the web app uses studio-api-prod.suno.com)
SUNO_STUDIO_API_URL=
TWOCAPTCHA_KEY=
BROWSER=chromium
BROWSER_GHOST_CURSOR=false
BROWSER_LOCALE=en
BROWSER_HEADLESS=true

# App runtime configuration
HOST=127.0.0.1
PORT=3000
# Build-time and runtime base path. Leave empty when serving from `/`.
# Example behind nginx reverse proxy: /tools/suno-api
APP_BASE_PATH=
# Directory where async /api/upload_file work states are stored.
# Default: ./.data/upload-file-works
UPLOAD_FILE_WORK_DIR=

# Docker published address configuration
DOCKER_BIND_HOST=127.0.0.1
DOCKER_HOST_PORT=3000
